# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Atlas Connection URI (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/houston_roofing?retryWrites=true&w=majority)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/houston_roofing"

# Admin Dashboard Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="HoustonRoofing2026!ChangeMe"

